        {
          "type": "text",
          "id": "fj1sh",
          "name": "状态说明",
          "fill": "#344253",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "成功 Package 折叠；失败 Package 保留 Hash 键。失败 Source 与 Pin 保留，bat 继续计算。",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 16,
          "fontWeight": "normal"
        },
