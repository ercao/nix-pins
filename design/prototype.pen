                  "fill": "#344253",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "启动失败已有 plain 降级；运行中 renderer 退出当前会触发取消。\n需区分展示故障与用户取消，才能实现 ADR 中的运行中降级目标。",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
