          "type": "text",
          "id": "rbGP7",
          "name": "原生级别限制",
          "fill": "#486983",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Prodash 只有 info / done / fail，没有独立 warn 样式。原型保留 warning: 正文前缀，\nwarning 不改变 Pin 状态；当前 origin 是整个 Item 名，长列需单独预算。",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        }
      ]
